{
  "name": "unirequest-backend-api",
  "version": "1.0.0",
  "description": "UniRequest-OS Backend REST API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
