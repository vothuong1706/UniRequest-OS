# Server Configuration
PORT=4000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# Database Configuration (PostgreSQL - thay giá trị change_me_* trước khi chạy thật)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=keycloak
DB_PASSWORD=change_me_postgres_2026
DB_NAME=keycloak

# Keycloak Configuration (khớp KC_HTTP_RELATIVE_PATH=/auth)
KEYCLOAK_REALM_URL=http://localhost:8080/auth/realms/unirequest
KEYCLOAK_ADMIN_URL=http://localhost:8080/auth
KEYCLOAK_REALM=unirequest
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change_me_keycloak_2026

# MinIO / Silo Object Storage Configuration (Private Bucket + Same-Origin Proxy)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_2026
MINIO_BUCKET_NAME=unirequest-files
MINIO_PUBLIC_URL=/api/upload/files

# Kestra Workflow Engine
KESTRA_ENABLED=true
KESTRA_URL=http://localhost:8085
KESTRA_NAMESPACE=unirequest.dxos
KESTRA_FLOW_ID=unirequest-lifecycle
KESTRA_WEBHOOK_KEY=change_me_kestra_webhook_2026
KESTRA_BASIC_AUTH_USER=admin@unirequest.edu.vn
KESTRA_BASIC_AUTH_PASSWORD=ChangeMeKestra2026!

# Security & External Seed Data
CORS_ALLOWED_ORIGINS=
ATTACHMENT_SIGNING_SECRET=
ATTACHMENT_SIGNED_URL_TTL_SECONDS=3600
SEED_DEMO_DATA=true
SEED_DATA_FILE=../../config/seed/demo-data.json
