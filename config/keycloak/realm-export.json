        {
          "type": "password",
          "value": "123456",
          "temporary": false
        }
      ],
      "realmRoles": ["canbo"]
    },
    {
      "username": "giangvien",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Tuấn",
      "lastName": "Lê Anh",
      "email": "giangvien@unirequest.edu.vn",
      "credentials": [
        {
          "type": "password",
          "value": "123456",
          "temporary": false
        }
      ],
