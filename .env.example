# ==============================================================================
# UniRequest-OS - Environment Variables Template
# Sao chép thành .env trước khi chạy: make env (hoặc cp .env.example .env)
#
# ⚠️ CẢNH BÁO BẢO MẬT:
# Toàn bộ giá trị `change_me_*` bên dưới chỉ dùng cho môi trường phát triển /
# kiểm thử nội bộ trên máy sạch. BẮT BUỘC thay đổi toàn bộ mật khẩu, khóa
# webhook và sinh cặp khóa VAPID riêng trước khi triển khai thực tế!
# ==============================================================================

# PostgreSQL (Shared OLTP & Keycloak Database)
TZ=Asia/Ho_Chi_Minh
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change_me_postgres_2026

# Keycloak Bootstrap Admin
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change_me_keycloak_2026

# Kong Gateway Database
KONG_PG_DB=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=change_me_kong_2026

# MinIO / Silo S3 Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_2026

# Kestra Workflow Engine (Apache-2.0)
KESTRA_BASIC_AUTH_USER=admin@unirequest.edu.vn
KESTRA_BASIC_AUTH_PASSWORD=ChangeMeKestra2026!
KESTRA_WEBHOOK_KEY=change_me_kestra_webhook_2026

# Web Push Notification (VAPID keys - để trống sẽ tắt Web Push; tạo cặp khóa mới bằng: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:admin@unirequest.edu.vn
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Bảo mật ứng dụng & Dữ liệu mẫu máy sạch (tách hoàn toàn khỏi code vào config/seed/demo-data.json)
CORS_ALLOWED_ORIGINS=
ATTACHMENT_SIGNING_SECRET=
ATTACHMENT_SIGNED_URL_TTL_SECONDS=3600
SEED_DEMO_DATA=true
SEED_DATA_FILE=/usr/src/app/seed/demo-data.json

# Không gian [I] Intelligence (Ollama LLM + Local NLP Fallback)
AI_ENABLED=true
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TIMEOUT_MS=3500
